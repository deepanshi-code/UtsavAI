# Get a free key at https://aistudio.google.com/apikey
# Copy this file to .env.local and fill it in. Never commit .env.local.
GEMINI_API_KEY=
# Optional: real vendor/venue/hotel listings with phone numbers, ratings and websites.
# Needs a Google Cloud project with "Places API (New)" enabled (Enterprise-tier fields, billed).
# Without it the app links to Google Maps searches instead.
# GOOGLE_MAPS_API_KEY=
# Optional: models to try in order, comma-separated (falls back on errors/timeouts)
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
